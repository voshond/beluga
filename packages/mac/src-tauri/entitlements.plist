<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The bundled Node (the part of Beluga that runs your room) compiles JavaScript as it runs. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Native modules (terminals, peer-to-peer) are loaded by that Node. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Automation (an optional step in the welcome): Claude working with your other apps. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <!-- Speaking instead of typing (Settings › Voice): the hardened runtime needs this for the microphone. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Calls (BLG-714): your camera, when you turn it on in a call. -->
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
