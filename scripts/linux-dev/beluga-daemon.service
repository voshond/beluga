[Unit]
Description=Beluga daemon (dev, from @REPO@)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@
Environment=PATH=@PATH@
ExecStart=@REPO@/node_modules/.bin/tsx src/cli.ts daemon --keep-alive
Restart=always
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=default.target
