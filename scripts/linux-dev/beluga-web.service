[Unit]
Description=Beluga in a browser (dev gateway on :8420, from @REPO@)
After=network-online.target beluga-daemon.service
Wants=network-online.target beluga-daemon.service

[Service]
Type=simple
WorkingDirectory=@REPO@
Environment=PATH=@PATH@
# The window is rebuilt from your working copy on every (re)start: Vite only, no typecheck, so work
# in progress doesn't keep Beluga down. "-": a failed build serves the last good one.
# The last builds' files stay a week: a page opened before a redeploy still finds the views it
# loads later (their names change with every build).
ExecStartPre=-/usr/bin/sh -c 'cd packages/mac && node_modules/.bin/vite build --logLevel warn --emptyOutDir false && find dist/assets -type f -mtime +7 -delete'
ExecStart=@REPO@/node_modules/.bin/tsx src/cli.ts web --host 0.0.0.0
Restart=always
RestartSec=3
TimeoutStartSec=300

[Install]
WantedBy=default.target
